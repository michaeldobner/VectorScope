{
  "name": "vectorscope",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "description": "VectorScope: personal live situational awareness. Module collection with a shared shell.",
  "author": "Michael Dobner",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config air/vite.config.ts",
    "build": "tsc --noEmit && vite build --config air/vite.config.ts && vite build --config intel/vite.config.ts && node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e.mjs",
    "release": "node scripts/release.mjs",
    "dev:intel": "vite --config intel/vite.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "maplibre-gl": "^5.24.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
